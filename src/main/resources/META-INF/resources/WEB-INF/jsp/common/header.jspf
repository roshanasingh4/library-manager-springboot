<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${pageTitle} | Library Manager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<c:url value='/css/app.css'/>">
</head>
<body>
<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="<c:url value='/'/>">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>Library Manager</span>
        </a>
        <nav class="nav" aria-label="Main">
            <a href="<c:url value='/'/>" class="${activePage == 'home' ? 'active' : ''}">Overview</a>
            <a href="<c:url value='/authors'/>" class="${activePage == 'authors' ? 'active' : ''}">Authors</a>
            <a href="<c:url value='/books'/>" class="${activePage == 'books' ? 'active' : ''}">Books</a>
        </nav>
        <div class="nav-actions">
            <a class="btn btn-primary btn-block" href="<c:url value='/books/new'/>">Add book</a>
            <a class="btn btn-quiet btn-block" href="<c:url value='/authors/new'/>">Add author</a>
        </div>
        <p class="credit">Roshan Avadhesh Singh<br>Roll No. 2024eb03006</p>
    </aside>
    <main class="content">
        <c:if test="${not empty successMessage}">
            <div class="notice notice-success" role="status">${successMessage}</div>
        </c:if>
